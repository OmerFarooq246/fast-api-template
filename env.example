ENVIRONMENT=local
PROJECT_NAME=fast-api-template
VERSION=v1
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
LOG_FORMAT=console
READINESS_TIMEOUT_SECONDS=2

DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/fast_api_template
SECRET_KEY=replace-with-a-random-secret-containing-at-least-32-characters
ALGORITHM=HS256
JWT_ISSUER=fast-api-template
JWT_AUDIENCE=fast-api-template-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Tests require a dedicated database whose name contains "test".
TEST_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/fast_api_template_test
